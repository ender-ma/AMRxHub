# Copy to .env and fill in. Never commit .env oooo or youll find out why.
# Core
DEBUG=True
ENVIRONMENT=development
SECRET_KEY=
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=
SESSION_COOKIE_DOMAIN=
SITE_ID=1

# Database (Postgres connection string)
DATABASE_URL=

# Media storage, in the form cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email
BREVO_API_KEY=
DEFAULT_FROM_EMAIL=
TOOL_FLAG_EMAIL=
USE_SMTP_IN_DEV=False
EMAIL_TIMEOUT=5

# Background tasks (in-memory defaults only work for local development)
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
